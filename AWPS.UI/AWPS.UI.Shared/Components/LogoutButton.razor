@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@code
{
    [SupplyParameterFromForm]
    private object FormModel { get; set; } = null!; //Init by OnInitialized()

    protected override void OnInitialized()
    {
        FormModel ??= new object();
    }
}
@code
{
    private async Task LogoutAsync()
    {
        var result = await AuthService.LogoutAsync();
        if (result.IsSuccess)
        {
            NavigationManager.NavigateTo("/Account/Login", forceLoad: true);
        }
    }
}

<EditForm Model=@FormModel OnSubmit=@LogoutAsync FormName="logout" method="post">
    <button type="submit" class="flex w-full cursor-pointer items-center gap-2 px-4 py-2 text-left text-sm text-gray-800 transition hover:bg-green-100">       
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7" />
        </svg>
        Logout
    </button>
</EditForm>