@inject IApplicationDbInteractor ApplicationDb
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory

<div class="fixed top-0 left-0 z-50 w-full bg-green-600 text-white shadow-md">
    <div class="px-4 py-3">
        <div class="flex items-center gap-6">
            <div class="relative" @ref="DropdownRef">
                <button @onclick="ToggleDropdown"
                        class="flex cursor-pointer items-center gap-2 rounded-xl bg-green-500 px-4 py-2 text-sm font-medium shadow transition hover:bg-green-400">
                    <span>@UserEmail</span>
                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="h-4 w-4 transition-transform @(IsDropdownOpen ? "rotate-180" : "")"
                         fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                <div class="@DropdownClasses">
                    <button @onclick="LogoutAsync" 
                        class="flex w-full cursor-pointer items-center gap-2 px-4 py-2 text-left text-sm text-gray-800 transition hover:bg-green-100">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7" />
                        </svg>
                        Logout
                    </button>
                    <button @onclick="DeleteUserAsync"
                            class="flex w-full cursor-pointer items-center gap-2 px-4 py-2 text-left text-sm text-red-600 transition hover:bg-red-100">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="h-4 w-4"
                             fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                        Delete account
                    </button>
                </div>
            </div>
            <a href="/" class="text-sm font-semibold text-white transition hover:text-green-200">
                Home
            </a>
        </div>
    </div>
</div>
<div class="pt-16">@ChildContent</div>

@code
{
    [Parameter] public RenderFragment? ChildContent { get; set; } 

    private string? UserEmail;
    private bool IsDropdownOpen;

    private ElementReference DropdownRef;
    private DotNetObjectReference<NavBar>? ObjRef;

    private string DropdownClasses =>
        $"absolute mt-2 w-48 bg-white text-gray-800 rounded-xl shadow-lg overflow-hidden transform transition-all duration-200 origin-top " +
        (IsDropdownOpen
            ? "opacity-100 scale-100 pointer-events-auto"
            : "opacity-0 scale-95 pointer-events-none");

    protected override async Task OnInitializedAsync()
    {
        var result = await ApplicationDb.GetCurrentUserEmail();
        if (result.IsSuccess)
        {
            UserEmail = result;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ObjRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("navbarInterop.registerOutsideClick", DropdownRef, ObjRef);
        }
    }

    private void ToggleDropdown()
    {
        IsDropdownOpen = !IsDropdownOpen;
    }

    [JSInvokable]
    public void CloseDropdown()
    {
        IsDropdownOpen = false;
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        Result result = Result.Error("Failed to connect to the server");
        if(base.RendererInfo.Name is not Renderer.Server)
        {
            result = await AuthService.LogoutAsync();
        }
        else
        {
            try
            {
                using HttpClient client = HttpClientFactory.CreateClient(HttpClientKey.Server);
                using HttpResponseMessage response = await client.PostAsync("/identity/logout", null);
                if(response.IsSuccessStatusCode is true)
                {
                    result = Result.Success();
                }
            }
            catch
            {
                result = Result.CriticalError();
            }
        }
        if(result.IsSuccess)
        {
            NavigationManager.NavigateTo("/Account/Login", true);
        }
    }

    private async Task DeleteUserAsync()
    {
        var result = await ApplicationDb.DeleteCurrentUser();
        if (result.IsSuccess)
        {
            await LogoutAsync();
        }
    }

    public void Dispose()
    {
        ObjRef?.Dispose();
    }
}