<Router AppAssembly=@typeof(MainLayout).Assembly NotFoundPage=@typeof(NotFoundPage)>
    <Found Context="route_data">
        <AuthorizeRouteView RouteData=@route_data DefaultLayout=@typeof(MainLayout)>
            <NotAuthorized>
                <LoginPage />
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
</Router>