@inject IApplicationDbInteractor ApplicationDb

<LoadScreen>  
    <NavBar>
        <div class="space-y-4 p-6">

            <CreateProfileButton />

            @if (Profiles is null)
            {
                <div class="text-gray-500">Loading...</div>
            }
            else if (Profiles.Length == 0)
            {
                <div class="py-10 text-center text-gray-500">
                    No profiles yet
                </div>
            }
            else
            {
                @foreach (var profile in Profiles)
                {
                    <DeviceProfileButton Profile="profile" OnChanged="LoadProfiles" />
                }
            }

        </div>
    </NavBar>
</LoadScreen>

@code {
    private DeviceProfileEntity[]? Profiles;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfiles();
    }

    private async Task LoadProfiles()
    {
        var result = await ApplicationDb.GetDeviceProfiles();
        if (result.IsSuccess)
        {
            Profiles = result.Value;
        }
    }
}