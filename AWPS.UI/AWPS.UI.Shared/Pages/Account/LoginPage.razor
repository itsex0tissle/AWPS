@page "/Account/Login"
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@code
{
    [SupplyParameterFromForm]
    private AuthLoginForm FormModel { get; set; } = null!; //Init by OnInitialized()

    protected override void OnInitialized()
    {
        FormModel ??= new AuthLoginForm();
    }
}
@code
{
    private string[] Errors { get; set; } = [];
    private bool IsLoading { get; set; } = false;

    private async Task LoginAsync()
    {
        try
        {
            IsLoading = true;
            Result result = await AuthService.LoginAsync(FormModel.Email, FormModel.Password, FormModel.RememberMe);
            if(result.IsSuccess is true)
            {
                NavigationManager.NavigateTo("/", forceLoad: true);
            }
            else
            {
                Errors = result.Errors.ToArray();
            }
        }
        finally
        {
            IsLoading = false;
        }
    }
}

<LoadScreen>
    <div class="flex h-screen items-center justify-center bg-gray-100 px-4">
        <div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-lg">
            <h2 class="mb-6 text-center text-2xl font-bold text-gray-800">Sign in</h2>
            @if (Errors.Length > 0)
            {
                <div class="mb-4 rounded-lg bg-red-100 p-4 text-sm text-red-700">
                    <ul class="list-inside list-disc">
                        @foreach (string error in Errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }
            <EditForm Model=@FormModel FormName="login" OnValidSubmit=@LoginAsync>
                <DataAnnotationsValidator />
                <div class="mb-4">
                    <label class="mb-1 block text-sm font-medium text-gray-700">Email</label>
                    <InputText @bind-Value=@FormModel.Email class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:outline-none" />
                    <ValidationMessage For=@(() => FormModel.Email) class="mt-1 text-sm text-red-600" />
                </div>
                <div class="mb-4">
                    <label class="mb-1 block text-sm font-medium text-gray-700">Password</label>
                    <InputText @bind-Value=@FormModel.Password type="password" class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:outline-none" />
                    <ValidationMessage For=@(() => FormModel.Password) class="mt-1 text-sm text-red-600" />
                </div>
                <div class="mb-6 flex items-center">
                    <InputCheckbox @bind-Value=@FormModel.RememberMe class="h-4 w-4 rounded border-gray-300 text-green-600 focus:ring-green-500" />
                    <label class="ml-2 text-sm text-gray-700">Remember me</label>
                </div>
                <button type="submit" disabled=@IsLoading class="flex w-full items-center justify-center gap-2 rounded-lg bg-green-600 px-4 py-2 font-medium text-white transition duration-200 hover:bg-green-700 disabled:cursor-not-allowed disabled:opacity-50">
                    @if (IsLoading is true)
                    {
                        <svg class="h-5 w-5 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                        </svg>
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <span>Sign in</span>
                    }
                </button>
            </EditForm>
            <p class="mt-6 text-center text-sm text-gray-500">
                <span>Don't have an account?</span>
                <a href="/Account/Register" class="text-green-600 hover:underline">Sign up</a>
            </p>
        </div>
    </div>
</LoadScreen>