@page "/Profile/{Id}"
@attribute [Authorize]
@code
{
    [Parameter] public required string Id { get; set; }
}

@if(base.RendererInfo.Name is not Renderer.WebView)
{
    <ProfilePageContent DeviceProfileId=@Id @rendermode=@RenderMode.InteractiveServer />
}
else
{
    <ProfilePageContent DeviceProfileId=@Id />
}