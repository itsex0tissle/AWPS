@using AWPS.UI.Shared.Services
@inject IApplicationDbInteractor ApplicationDb
@inject TelemetryHubClientService TelemetryHubClient
@implements IAsyncDisposable
@code
{
    [Parameter] public required string DeviceProfileId { get; set; }

    protected override async Task OnInitializedAsync()
    {       
        if(TelemetryHubClient.ConnectionState != Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected)
        {
            if(Chart != null && _previousDeviceProfileId != null && _previousDeviceProfileId != DeviceProfileId)
            {
                await TelemetryHubClient.UnsubscribeFromDeviceAsync(_previousDeviceProfileId);
            }
            await TelemetryHubClient.ConnectAsync(OnTelemetryUpdatedAsync);
            await TelemetryHubClient.SubscribeToDeviceAsync(DeviceProfileId);
            _previousDeviceProfileId = DeviceProfileId;
        }
        await UpdateChartAsync();
    }
}
@code
{
    private string? _previousDeviceProfileId;
    private TelemetryEntity[] Data { get; set; } = [];
    private ApexChart<TelemetryEntity>? Chart { get; set; }
    private ApexChartOptions<TelemetryEntity> ChartOptions { get; set; } = new()
    {
        Chart = new Chart
        {
            Type = ChartType.Line,
            Height = 400
        },
        Stroke = new Stroke
        {
            Curve = new CurveSelections(Curve.Smooth)
        }
    };
    private string SelectedMetric
    {
        get => field;
        set
        {
            field = value;
            _ = Chart?.UpdateSeriesAsync();
        }
    } = "Light";

    private decimal? GetYValue(TelemetryEntity m)
    {
        return SelectedMetric switch
        {
            "Light" => m.Light,
            "Moisture" => m.Moisture,
            "Humidity" => m.Humidity,
            "Temperature" => m.Temperature,
            _ => 0
        };
    }
    private object GetXText(TelemetryEntity x)
    {
        return DateTime.FromBinary(x.Timestamp).ToLocalTime().ToString("yyyy.MM.dd - HH:mm");
    }
    private async Task ClearData()
    {
        await ApplicationDb.ClearTelemetry(DeviceProfileId);
        await UpdateChartAsync();
    }
    private async Task OnTelemetryUpdatedAsync(string deviceProfileId)
    {
        if (deviceProfileId == DeviceProfileId)
        {
            await InvokeAsync(async () =>
            {
                await UpdateChartAsync();
                Console.WriteLine("Telemetry updated");
            });
        }
    }
    private async Task UpdateChartAsync()
    {
        Result<TelemetryEntity[]> result = await ApplicationDb.GetTelemetry(DeviceProfileId);
        if (result.IsSuccess)
        {
            Data = result.Value;
        }
        if (Chart != null)
        {
            await Chart.UpdateSeriesAsync();
        }
        SelectedMetric = SelectedMetric;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_previousDeviceProfileId != null)
        {
            await TelemetryHubClient.UnsubscribeFromDeviceAsync(_previousDeviceProfileId);
        }
        await TelemetryHubClient.DisposeAsync();
    }
}

<LoadScreen>
    <NavBar>       
        <div class="flex h-full flex-col p-6">
            <div class="mb-6 flex items-center justify-between">
                <h1 class="text-3xl font-bold text-gray-800">Telemetry</h1>
                <a href=@($"/Device/{DeviceProfileId}") class="rounded-lg bg-green-600 px-4 py-2 text-white shadow hover:bg-green-700">Configure Device</a>
            </div>
            <div class="flex-1 overflow-y-auto rounded-xl bg-white p-6 shadow">
                <div class="mb-4">
                    <label class="mb-1 block text-sm font-medium text-gray-600">Select parameter</label>
                    <select @bind="SelectedMetric" class="w-64 cursor-pointer rounded-lg border px-3 py-2">
                        <option value="Light" >Light</option>
                        <option value="Moisture">Soil Moisture</option>
                        <option value="Humidity">Air Humidity</option>
                        <option value="Temperature">Temperature</option>
                    </select>
                    <button @onclick="ClearData" class="h-10 cursor-pointer rounded-lg bg-red-600 px-4 text-white shadow hover:bg-red-700">Clear Data</button>
                </div>
                <ApexChart TItem="TelemetryEntity" Options="ChartOptions" @ref="Chart">
                    <ApexPointSeries TItem="TelemetryEntity" Items="Data" Name="@SelectedMetric" XValue=@GetXText YValue="GetYValue" />
                </ApexChart>
            </div>
        </div>
    </NavBar>
</LoadScreen>