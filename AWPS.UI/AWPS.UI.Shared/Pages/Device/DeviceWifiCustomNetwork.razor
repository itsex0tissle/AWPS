@inject IDeviceInteractor DeviceInteractor
@code
{
    [Parameter] public EventCallback ReloadState { get; set; }
    [Parameter] public required DeviceNotConnectedModal ModalRef { get; set; }
}
@code
{
    private bool IsSelected { get; set; }
    private string Ssid { get; set; } = "";
    private string Password { get; set; } = "";
    private bool IsSaveCredentialsFaulted { get; set; }
    private WifiConnectionResultRecord? WifiConnectionResult { get; set; }

    private async Task SelectThis()
    {
        IsSelected = !IsSelected;
        await InvokeAsync(StateHasChanged);
    }
    private async Task ConnectToWifi()
    {
        WifiConnectionResult = null;
        IsSaveCredentialsFaulted = false;
        try
        {
            if(await ModalRef.SendPing() is true)
            {
                WifiConnectionResult = await DeviceInteractor.ConnectToWifi(new WifiCredentialsRecord()
                {
                    SSID = Ssid,
                    Password = Password
                });
                if(WifiConnectionResult.Connected is true)
                {
                    await ReloadState.InvokeAsync();
                    IsSelected = false; // згортаємо після успіху
                }
            }
        }
        catch
        {
            WifiConnectionResult = new WifiConnectionResultRecord()
            {
                Connected = false,
                Message = "Unexpected error"
            };
        }
    }
    private async Task SaveCredentials()
    {
        WifiConnectionResult = null;
        IsSaveCredentialsFaulted = false;
        try
        {
            if(await ModalRef.SendPing() is true)
            {
                await DeviceInteractor.SaveCredentials(new WifiCredentialsRecord()
                {
                    SSID = Ssid,
                    Password = Password
                });
                await ReloadState.InvokeAsync();
            }
        }
        catch
        {
            IsSaveCredentialsFaulted = true;
        }
    }
}

<div class="rounded-xl border border-green-200 bg-white p-3 shadow-sm">
    <div class="flex cursor-pointer items-center justify-between" @onclick=@SelectThis>
        <div class="font-medium">Custom network</div>
        <div class="text-sm text-green-500">@(IsSelected ? "▲" : "▼")</div>
    </div>
    @if(IsSelected is true)
    {
        <div class="mt-3 space-y-2">
            <input type="text"
                   @bind=@Ssid
                   placeholder="SSID"
                   class="w-full rounded-lg border border-green-300 px-3 py-2 focus:ring-2 focus:ring-green-400 focus:outline-none" />
            <input type="password"
                   @bind=@Password
                   placeholder="Password"
                   class="w-full rounded-lg border border-green-300 px-3 py-2 focus:ring-2 focus:ring-green-400 focus:outline-none" />
            @if(WifiConnectionResult?.Connected is false)
            {
                <div class="text-sm text-red-500">@WifiConnectionResult.Message</div>
            }
            <div class="flex items-center gap-x-1">               
                <ResultableButton OnClick=@ConnectToWifi IsFaulted=@(WifiConnectionResult?.Connected is false)>Connect</ResultableButton>
                <ResultableButton OnClick=@SaveCredentials IsFaulted=@IsSaveCredentialsFaulted>Save</ResultableButton>
            </div>
        </div>
    }
</div>