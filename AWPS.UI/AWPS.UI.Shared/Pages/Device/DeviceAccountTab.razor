@inject NavigationManager NavigationManager
@inject IDeviceInteractor DeviceInteractor
@code
{
    [Parameter] public required string Id { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender is true)
        {            
            await GetAccountAsync();            
        }
    }
}
@code
{
    private DeviceNotConnectedModal DeviceNotConnectedModalRef { get; set; } = null!; //Init by @ref tag-helper
    private AccountRecord? AccountRecord { get; set; }

    private async Task DeleteAccountHandle()
    {
        if(await DeviceNotConnectedModalRef.SendPing() is true)
        {
            try
            {
                await DeviceInteractor.DeleteAccount();
                await GetAccountAsync();
            }
            catch { }
        }
    }
    private async Task PostAccountHandle()
    {
        if(await DeviceNotConnectedModalRef.SendPing() is true)
        {
            try
            {
                await DeviceInteractor.PostAccount(new AccountRecord()
                {
                    DeviceProfileId = Id
                });
                await GetAccountAsync();
            }
            catch { }
        }
    }
    private async Task GetAccountAsync()
    {
        if(await DeviceNotConnectedModalRef.SendPing() is true)
        {
            try
            {
                AccountRecord = await DeviceInteractor.GetAccount();
                await InvokeAsync(StateHasChanged);
            }
            catch { }
        }
    }
}

<DeviceNotConnectedModal @ref=@DeviceNotConnectedModalRef />
<div class="flex h-full flex-col items-center justify-center">
    <p class="m-15 text-center text-6xl text-gray-600">Account page</p>
    @if(AccountRecord is not null)
    {
        if(AccountRecord.DeviceProfileId is null)
        {
            <p class="m-3 text-center text-xl text-gray-600">No account binded to the device</p>
        }
        else if(AccountRecord.DeviceProfileId == Id)
        {
            <p class="m-3 text-center text-xl text-green-600">Device binded to the current profile</p>
        }
        else
        {
            <p class="m-3 text-center text-xl text-yellow-600">Device binded to the another profile</p>
        }
    }
    else
    {
        <p class="m-3 text-center text-xl text-gray-600">No information about binded account in the device</p>
    }
    <div class="m-6 flex flex-row gap-2">
        <LoadableButton OnClick=@PostAccountHandle>Bind</LoadableButton>
        <LoadableButton OnClick=@DeleteAccountHandle>Clear</LoadableButton>
    </div>
</div>