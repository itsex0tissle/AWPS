@code
{
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
@code
{
    private bool Open { get; set; } = true;

    private void Toggle()
    {
        Open = !Open;
    }
}

<div class="relative flex h-screen overflow-hidden bg-green-50">
    @if(Open is false)
    {
        <button class="fixed top-4 left-4 z-50 flex h-10 w-10 items-center justify-center rounded-full bg-green-700 text-white shadow-lg ring-1 ring-green-200 transition-all duration-300 hover:scale-110 hover:bg-green-600 active:scale-95"
                @onclick="@Toggle"
                aria-label="Expand navigation">☰</button>
    }
    @if(Open is true)
    {
        <aside class="fixed inset-0 z-40 w-full bg-green-800 text-white
            transition-all duration-300 ease-out
            sm:relative
            sm:inset-auto sm:z-auto sm:w-60 sm:flex-none">
            <div class="relative flex items-center p-3 sm:p-4">
                <span class="pointer-events-none font-bold text-white">Device Configuration</span>
                <button class="absolute top-1/2 right-3 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-green-700 text-white shadow-md transition-all duration-300 hover:scale-110 hover:bg-green-600 active:scale-95"
                        @onclick="@Toggle"
                        aria-label="Collapse navigation">☰</button>
            </div>
            <nav class="flex w-full flex-col gap-1 px-1">
                <NavLink href="/DeviceConfiguration"
                         class="block w-full px-4 py-3 text-left transition-all duration-200 hover:bg-green-700 hover:pl-5 focus:outline-none"
                         ActiveClass="scale-[1.02] bg-green-600 text-white"
                         Match="@NavLinkMatch.All">
                    <span class="block w-full transition-all duration-200">Home</span>
                </NavLink>
                <NavLink href="/DeviceConfiguration/Wifi"
                         class="block w-full px-4 py-3 text-left transition-all duration-200 hover:bg-green-700 hover:pl-5 focus:outline-none"
                         ActiveClass="scale-[1.02] bg-green-600 text-white"
                         Match="@NavLinkMatch.All">
                    <span class="block w-full transition-all duration-200">Wifi</span>
                </NavLink>
            </nav>
        </aside>
    }
    <main class="flex-1 overflow-auto p-14 transition-all duration-300 data-[open]:p-4" data-open=@Open>@ChildContent</main>
</div>