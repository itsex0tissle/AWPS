@code
{
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

@if(base.RendererInfo.Name is Renderer.Static && base.AssignedRenderMode is not null)
{   
    <div class="flex min-h-screen w-full items-center justify-center bg-green-50">
        <div class="flex flex-col items-center gap-4">
            <div class="h-14 w-14 animate-spin rounded-full border-4 border-green-200 border-t-green-600"></div>
            <p class="text-sm font-medium text-green-700">Loading...</p>
        </div>
    </div>
}
else
{
    @ChildContent
}